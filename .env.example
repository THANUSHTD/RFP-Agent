# Environment variables for RFP Agent
# Copy this to .env and fill in your values. Never commit .env.

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...

# Model names — never hardcode in source; always read from config.
FAST_MODEL=gpt-4o-mini          # Triage, parsing, extraction, verification, redaction
DRAFT_MODEL=gpt-4o              # Answer drafting, rewrites, chat agent
EMBEDDING_MODEL=text-embedding-3-small

# ── Product / Staleness ───────────────────────────────────────────────────────
CURRENT_PRODUCT_VERSION=3.0.0   # Semver; sources below this version trigger stale warning
STALE_AFTER_MONTHS=18           # Documents older than this (months) trigger stale warning

# ── Retrieval ─────────────────────────────────────────────────────────────────
CONFIDENCE_HIGH=0.75            # >= this => confident answer (starting point, tune against data)
CONFIDENCE_LOW=0.45             # < this => clarification (between LOW and HIGH => low_confidence draft)
RETRIEVAL_TOP_K=8               # Chunks to retrieve per question (before RRF merge)

# ── Concurrency ───────────────────────────────────────────────────────────────
MAX_CONCURRENCY=4               # Max simultaneous question-processing coroutines

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./rfp_agent.db
CHROMA_DIR=./chroma_db

# ── Upload ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50

# ── Service URLs ─────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
